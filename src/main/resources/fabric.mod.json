{
  "schemaVersion": 1,
  "id": "activity",
  "version": "${version}",
  "name": "CooldownHUD",
  "description": "Отображение активных серверных кулдаунов PVP-предметов и механик Minecraft (Эндер-жемчуг, Вагонетки с динамитом, Заряд ветра, Копьё/Трезубец, Золотые яблоки, Хорусы, Щиты, Булава)",
  "authors": [
    "BRAT12344321"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/activity/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "activity.client.NivoratClient"
    ]
  },
  "mixins": [
    "activity.autotool.mixins.json",
    "activity.autogg.mixins.json",
    "activity.dev.mixins.json",
    "activity.cooldown.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "provides": [
    "nivoratclient",
    "cooldown_hud"
  ],
  "custom": {
    "modmenu": {
      "badges": [
        "library"
      ],
      "parent": {
        "id": "cooldown_hud",
        "name": "Cooldown Hud",
        "description": "Отображение активных серверных кулдаунов PVP-предметов",
        "icon": "assets/activity/icon.png"
      }
    }
  }
}