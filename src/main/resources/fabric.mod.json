{
  "schemaVersion": 1,
  "id": "activity",
  "version": "${version}",
  "name": "PulseHUD",
  "description": "PulseHUD: продвинутый клиентский интерфейс, HUD и боевые механики для Minecraft 1.21.11.",
  "authors": [
    "Pulse"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/activity/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "activity.client.CooldownHudClient"
    ],
    "nivorat:settings_v1": [
      "activity.client.integration.ClientIntegrationProvider"
    ]
  },
  "mixins": [
    "activity.pipeline.mixins.json",
    "activity.audio.mixins.json",
    "activity.dev.mixins.json",
    "activity.cooldown.mixins.json",
    "activity.custom-render.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "provides": [
    "nivoratclient"
  ],
  "custom": {
    "modmenu": {
      "badges": []
    }
  },
  "jars": [
    {
      "file": "META-INF/jars/ClientSpoofer-1.21.11-1.4.0.jar"
    }
  ]
}
