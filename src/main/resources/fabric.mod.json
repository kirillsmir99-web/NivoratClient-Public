{
  "schemaVersion": 1,
  "id": "activity",
  "version": "${version}",
  "name": "NivoratClient",
  "description": "NivoratClient modern dark settings UI",
  "authors": [
    "Nivorat"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/activity/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "activity.client.NivoratClient",
      "squeek.appleskin.AppleSkin"
    ],
    "main": [
      "squeek.appleskin.AppleSkinCommon"
    ]
  },
  "mixins": [
    "activity.autotool.mixins.json",
    "activity.autogg.mixins.json",
    "activity.appleskin.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "provides": [
    "nivoratclient",
    "appleskin"
  ],
  "custom": {
    "modmenu": {
      "badges": [
        "library"
      ],
      "parent": "minecraft"
    }
  }
}