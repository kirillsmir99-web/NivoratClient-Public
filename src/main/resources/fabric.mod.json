{
  "schemaVersion": 1,
  "id": "activity",
  "version": "${version}",
  "name": "PulseHUD",
  "description": "Отображение активных серверных кулдаунов PVP-предметов и механик Minecraft (Эндер-жемчуг, Вагонетки с динамитом, Заряд ветра, Копьё, Золотые яблоки, Хорусы, Щиты, Булава)",
  "authors": [
    "kt1xW"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/activity/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "activity.client.CooldownHudClient"
    ]
  },
  "mixins": [
    "activity.pipeline.mixins.json",
    "activity.audio.mixins.json",
    "activity.dev.mixins.json",
    "activity.cooldown.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": ">=1.21.1 <=1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "provides": [
    "pulse_hud",
    "pulsehud",
    "cooldown_hud",
    "cooldownhud",
    "nivoratclient"
  ],
  "custom": {
    "modmenu": {
      "badges": []
    }
  }
}